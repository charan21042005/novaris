# ==============================================================================
# NOVARIS .gitignore
# ==============================================================================

# Compiled Binaries & Object Files
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Go Cache & Coverage
*.coverprofile
coverage.txt

# Python & ML Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv
venv/
ENV/
.pytest_cache/
.coverage
htmlcov/

# Node & Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
.turbo/
.next/

# IDE & Editor Configs
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.pem
*.key
